{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: configure",
            "command": "cmake",
            "args": ["--preset", "default"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake: build",
            "command": "cmake",
            "args": ["--build", "build"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "CMake: configure",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Build the terminal_romanian_whist executable."
        },
        {
            "type": "shell",
            "label": "run",
            "command": "${workspaceFolder}/build/terminal_romanian_whist",
            "group": "test",
            "dependsOn": "CMake: build",
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared" }
        }
    ]
}
